{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["^build", "//#lint:root"]
		},
		"lint:write": {
			"dependsOn": ["^build"]
		},
		"test": {
			"dependsOn": ["^build", "//#test:commits", "//#test:format-staged"]
		},
		"//#lint:root": {
			"outputs": []
		},
		"//#test:commits": {
			"outputs": []
		},
		"//#test:format-staged": {
			"outputs": []
		}
	}
}
