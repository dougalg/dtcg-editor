{
	"name": "dtcg-editor",
	"private": true,
	"packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
	"engines": {
		"node": ">=26.5.0"
	},
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"storybook": "storybook dev -p 6006 --ci",
		"build-storybook": "storybook build",
		"lint": "turbo run lint",
		"lint:write": "turbo run lint:write",
		"lint:root": "biome lint commit-conventions.json commitlint.config.mjs commit-conventions.test.mjs format-staged.mjs format-staged.test.mjs",
		"lint:filenames": "ls-lint",
		"test": "turbo run test",
		"test:commits": "node --test commit-conventions.test.mjs",
		"test:format-staged": "node --test format-staged.test.mjs",
		"test:vitest": "pnpm --filter @dtcg-editor/web-app generate:icons && vitest run",
		"test:vitest:headed": "pnpm --filter @dtcg-editor/web-app generate:icons && vitest run --browser.headless=false",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"commit": "cz",
		"prepare": "husky"
	},
	"config": {
		"commitizen": {
			"path": "@commitlint/cz-commitlint"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@commitlint/cz-commitlint": "catalog:",
		"@ls-lint/ls-lint": "catalog:",
		"@storybook/addon-a11y": "catalog:",
		"@storybook/addon-docs": "catalog:",
		"@storybook/react-vite": "catalog:",
		"@types/node": "catalog:",
		"@vitejs/plugin-react": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"commitizen": "^4.3.2",
		"husky": "^9.1.7",
		"inquirer": "catalog:",
		"storybook": "catalog:",
		"turbo": "^2.10.12",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
