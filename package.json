{
	"name": "dtcg-editor",
	"private": true,
	"packageManager": "pnpm@11.18.0+sha512.33d83c77da82f49fba836925c6f1b841181ec3132b670639bd012f7075f5c7cf634c5f870147c19aae7478fac01df09d8892e880454896edd23ee9b33757563c",
	"engines": {
		"node": ">=26.5.0"
	},
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:root": "eslint commit-conventions.cjs commitlint.config.cjs .cz-config.cjs commit-conventions.test.cjs format-staged.cjs format-staged.test.cjs",
		"test": "turbo run test",
		"test:commits": "node --test commit-conventions.test.cjs",
		"test:format-staged": "node --test format-staged.test.cjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"commit": "cz",
		"prepare": "husky"
	},
	"config": {
		"commitizen": {
			"path": "cz-customizable"
		},
		"cz-customizable": {
			"config": "./.cz-config.cjs"
		}
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"commitizen": "^4.3.2",
		"cz-customizable": "^7.5.4",
		"eslint": "^10.8.0",
		"husky": "^9.1.7",
		"prettier": "^3.9.6",
		"turbo": "^2.10.7",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0"
	}
}
