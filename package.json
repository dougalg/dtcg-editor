{
	"name": "dtcg-editor",
	"private": true,
	"packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
	"engines": {
		"node": ">=26.5.0"
	},
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:write": "turbo run lint:write",
		"lint:root": "biome lint commit-conventions.cjs commitlint.config.cjs .cz-config.cjs commit-conventions.test.cjs format-staged.cjs format-staged.test.cjs",
		"lint:filenames": "ls-lint",
		"test": "turbo run test",
		"test:commits": "node --test commit-conventions.test.cjs",
		"test:format-staged": "node --test format-staged.test.cjs",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"commit": "cz",
		"prepare": "husky"
	},
	"config": {
		"commitizen": {
			"path": "cz-customizable"
		},
		"cz-customizable": {
			"config": "./.cz-config.cjs"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@ls-lint/ls-lint": "catalog:",
		"@types/node": "catalog:",
		"commitizen": "^4.3.2",
		"cz-customizable": "^7.5.4",
		"husky": "^9.1.7",
		"turbo": "^2.10.10",
		"typescript": "catalog:"
	}
}
