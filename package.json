{
	"name": "dtcg-editor",
	"private": true,
	"packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
	"engines": {
		"node": ">=26.5.0"
	},
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"lint:root": "eslint commit-conventions.cjs commitlint.config.cjs .cz-config.cjs commit-conventions.test.cjs format-staged.cjs format-staged.test.cjs",
		"test": "turbo run test",
		"test:commits": "node --test commit-conventions.test.cjs",
		"test:format-staged": "node --test format-staged.test.cjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"commit": "cz",
		"prepare": "husky"
	},
	"config": {
		"commitizen": {
			"path": "cz-customizable"
		},
		"cz-customizable": {
			"config": "./.cz-config.cjs"
		}
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@typescript-eslint/eslint-plugin": "^8.67.0",
		"@typescript-eslint/parser": "^8.67.0",
		"commitizen": "^4.3.2",
		"cz-customizable": "^7.5.4",
		"eslint": "^10.8.1",
		"husky": "^9.1.7",
		"prettier": "^3.9.6",
		"turbo": "^2.10.9",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.67.0"
	}
}
