{
	"name": "@dtcg-editor/web-app",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm generate:icons && next dev",
		"build": "pnpm generate:icons && next build",
		"start": "next start",
		"lint": "biome lint .",
		"lint:write": "biome lint --write .",
		"test": "pnpm generate:icons && pnpm test:unit && pnpm test:a11y",
		"test:unit": "vitest run",
		"test:a11y": "playwright test",
		"init-config": "node scripts/init-config.ts",
		"generate:icons": "node scripts/generate-icon-sprite.ts && biome format --write assets/icon-sprite.ts"
	},
	"dependencies": {
		"@dtcg-editor/design-system": "workspace:*",
		"@dtcg-editor/errors": "workspace:*",
		"@dtcg-editor/token-core": "workspace:*",
		"@dtcg-editor/token-editor-color": "workspace:*",
		"@dtcg-editor/token-editor-contract": "workspace:*",
		"@dtcg-editor/token-editor-dimension": "workspace:*",
		"neverthrow": "catalog:",
		"next": "16.3.1",
		"react": "catalog:",
		"react-dom": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.10",
		"axe-core": "^4.13.0",
		"jsdom": "^30.0.1",
		"playwright": "^1.62.1",
		"typescript": "catalog:",
		"vitest": "^4.1.10"
	}
}
